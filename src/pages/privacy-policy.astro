---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Privacy policy" description="Draft privacy policy for Prismbyte." canonical={`${site.url}/privacy-policy/`}>
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">Legal</p>
      <h1>Privacy policy draft.</h1>
    </header>

    <article class="static-page">
      <p>
        This draft privacy policy outlines how Prismbyte may handle information collected through the website. This is a preliminary policy and may be updated as the publication and operational systems evolve.
      </p>
      <h2>Information we may collect</h2>
      <p>
        Prismbyte may collect basic analytics and site usage information, contact details submitted through a form, and general interaction data needed to improve the website and content quality.
      </p>
      <h2>How we use information</h2>
      <p>
        Information may be used to respond to enquiries, understand how the website is used, improve content quality, and support editorial operations.
      </p>
      <h2>Third parties</h2>
      <p>
        We may use third-party services for operational support, analytics, or email communication in the future. This page will be updated as any such integration is implemented.
      </p>
      <p>
        For inquiries, contact <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </article>
  </div>
</BaseLayout>
