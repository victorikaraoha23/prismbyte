---
import { legalLinks, navItems, site } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="Prismbyte home">
        <img
          class="brand-logo brand-logo--desktop brand-logo--light"
          src="/prismbyte-logo.svg"
          alt=""
          width="320"
          height="80"
        />
        <img
          class="brand-logo brand-logo--desktop brand-logo--dark"
          src="/prismbyte-logo-dark.svg"
          alt=""
          width="320"
          height="80"
        />
        <img
          class="brand-logo brand-logo--mobile brand-logo--light"
          src="/prismbyte-icon.svg"
          alt=""
          width="48"
          height="48"
        />
        <img
          class="brand-logo brand-logo--mobile brand-logo--dark"
          src="/prismbyte-icon.svg"
          alt=""
          width="48"
          height="48"
        />
      </a>
      <p>{site.description}</p>
    </div>

    <div>
      <h3>Explore</h3>
      <ul class="footer-list">
        {navItems.slice(1).map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3>Legal</h3>
      <ul class="footer-list">
        {legalLinks.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </div>
</footer>
