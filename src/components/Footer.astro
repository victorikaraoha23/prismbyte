---
import { legalLinks, navItems, site } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="Prismbyte home">
        <img class="brand-logo brand-logo--desktop" id="logo-desktop-footer" src="/prismbyte-logo.svg" alt="" width="320" height="80" />
        <img class="brand-logo brand-logo--mobile" id="logo-mobile-footer" src="/prismbyte-icon.svg" alt="" width="48" height="48" />
      </a>
      <p>{site.description}</p>
    </div>

    <script is:inline>
      (() => {
        const STORAGE_KEY = 'prismbyte-theme';
        const root = document.documentElement;
        const logoDesktop = document.getElementById('logo-desktop-footer');

        function setThemeLogo() {
          const theme = root.getAttribute('data-theme') || 'light';
          logoDesktop.src = theme === 'dark' ? '/prismbyte-logo-dark.svg' : '/prismbyte-logo.svg';
        }

        setThemeLogo();

        root.addEventListener('themechange', setThemeLogo);
      })();
    </script>

    <div>
      <h3>Explore</h3>
      <ul class="footer-list">
        {navItems.slice(1).map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3>Legal</h3>
      <ul class="footer-list">
        {legalLinks.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </div>
</footer>
