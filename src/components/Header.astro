---
import { navItems } from '../data/site';

const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Prismbyte home">
      <img class="brand-logo brand-logo--desktop" id="logo-desktop" src="/prismbyte-logo.svg" alt="" width="320" height="80" />
      <img class="brand-logo brand-logo--mobile" id="logo-mobile" src="/prismbyte-logo.svg" alt="" width="320" height="80" />
    </a>

    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      aria-label="Switch theme"
      aria-pressed="false"
    >
      <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </span>
      <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79"/></svg>
      </span>
    </button>

    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="site-nav-menu"
    >
      <span class="menu-toggle__lines"></span>
    </button>

    <nav class="site-nav" aria-label="Main navigation" id="site-nav-menu">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={pathname === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
(() => {
  const STORAGE_KEY = 'prismbyte-theme';
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const sunIcon = toggle.querySelector('.theme-toggle__icon--sun');
  const moonIcon = toggle.querySelector('.theme-toggle__icon--moon');
  const logoDesktop = document.getElementById('logo-desktop');
  const logoMobile = document.getElementById('logo-mobile');

  function setIcons(theme) {
    if (theme === 'dark') {
      sunIcon.style.display = 'none';
      moonIcon.style.display = 'inline';
      toggle.setAttribute('aria-pressed', 'true');
    } else {
      sunIcon.style.display = 'inline';
      moonIcon.style.display = 'none';
      toggle.setAttribute('aria-pressed', 'false');
    }
  }

  function setLogos(theme) {
    const src = theme === 'dark' ? '/prismbyte-logo-dark.svg' : '/prismbyte-logo.svg';
    logoDesktop.src = src;
    logoMobile.src = src;
  }

  function setTheme(theme) {
    root.setAttribute('data-theme', theme);
    try {
      localStorage.setItem(STORAGE_KEY, theme);
    } catch {
      // The current page can still switch themes.
    }
    setIcons(theme);
    setLogos(theme);
    root.dispatchEvent(new CustomEvent('themechange'));
  }

  // Sync the header with the theme selected in the layout.
  const currentTheme = root.getAttribute('data-theme') || 'light';
  setIcons(currentTheme);
  setLogos(currentTheme);

  toggle.addEventListener('click', () => {
    const isDark = root.getAttribute('data-theme') === 'dark';
    setTheme(isDark ? 'light' : 'dark');
  });

  // Mobile menu
  const menuToggle = document.getElementById('menu-toggle');
  const navMenu = document.getElementById('site-nav-menu');
  const navLinks = navMenu.querySelectorAll('a');

  function toggleMenu() {
    const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', !isExpanded);
    navMenu.classList.toggle('site-nav--open', !isExpanded);
  }

  function closeMenu() {
    menuToggle.setAttribute('aria-expanded', 'false');
    navMenu.classList.remove('site-nav--open');
  }

  menuToggle.addEventListener('click', toggleMenu);

  navLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Close menu on Escape
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && navMenu.classList.contains('site-nav--open')) {
      closeMenu();
      menuToggle.focus();
    }
  });
})();
</script>
