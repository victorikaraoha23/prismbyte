---
import { navItems } from '../data/site';

const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Prismbyte home">
      <span class="brand-mark">P</span>
      <span>Prismbyte</span>
    </a>

    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      aria-label="Switch theme"
      aria-pressed="false"
    >
      <span class="theme-toggle__icon theme-toggle__icon--sun">☀️</span>
      <span class="theme-toggle__icon theme-toggle__icon--moon">🌙</span>
    </button>

    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="site-nav-menu"
    >
      <span class="menu-toggle__lines"></span>
    </button>

    <nav class="site-nav" aria-label="Main navigation" id="site-nav-menu">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={pathname === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
(() => {
  const STORAGE_KEY = 'prismbyte-theme';
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const sunIcon = toggle.querySelector('.theme-toggle__icon--sun');
  const moonIcon = toggle.querySelector('.theme-toggle__icon--moon');

  function setIcons(theme) {
    if (theme === 'dark') {
      sunIcon.style.display = 'none';
      moonIcon.style.display = 'inline';
      toggle.setAttribute('aria-pressed', 'true');
    } else {
      sunIcon.style.display = 'inline';
      moonIcon.style.display = 'none';
      toggle.setAttribute('aria-pressed', 'false');
    }
  }

  function setTheme(theme) {
    root.setAttribute('data-theme', theme);
    localStorage.setItem(STORAGE_KEY, theme);
    setIcons(theme);
  }

  // Initialize icons from current theme
  const currentTheme = root.getAttribute('data-theme') || 'light';
  setIcons(currentTheme);

  toggle.addEventListener('click', () => {
    const isDark = root.getAttribute('data-theme') === 'dark';
    setTheme(isDark ? 'light' : 'dark');
  });

  // Mobile menu
  const menuToggle = document.getElementById('menu-toggle');
  const navMenu = document.getElementById('site-nav-menu');
  const navLinks = navMenu.querySelectorAll('a');

  function toggleMenu() {
    const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', !isExpanded);
    navMenu.classList.toggle('site-nav--open', !isExpanded);
  }

  function closeMenu() {
    menuToggle.setAttribute('aria-expanded', 'false');
    navMenu.classList.remove('site-nav--open');
  }

  menuToggle.addEventListener('click', toggleMenu);

  navLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Close menu on Escape
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && navMenu.classList.contains('site-nav--open')) {
      closeMenu();
    }
  });
})();
</script>
