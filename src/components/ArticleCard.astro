---
import type { CollectionEntry } from 'astro:content';
import { categoryMeta } from '../data/site';
import { formatDate } from '../lib/content';

const { article } = Astro.props as { article: CollectionEntry<'articles'> };
const category = categoryMeta[article.data.category];
---

<article class="article-card">
  <span class="tag">{category.label}</span>
  <div class="meta">
    <time datetime={new Date(article.data.publishDate).toISOString()}>
      {formatDate(article.data.publishDate)}
    </time>
  </div>
  <h3><a href={`/blog/${article.id}/`}>{article.data.title}</a></h3>
  <p>{article.data.description}</p>
</article>
