---
---

<div
  id="newsletter-popup"
  class="newsletter-popup"
  role="dialog"
  aria-modal="true"
  aria-labelledby="newsletter-popup-title"
  aria-describedby="newsletter-popup-desc"
  hidden
>
  <div class="newsletter-popup__overlay"></div>

  <div class="newsletter-popup__panel">
    <button
      class="newsletter-popup__close"
      id="newsletter-popup-close"
      aria-label="Close"
      type="button"
    >
      <span aria-hidden="true">×</span>
    </button>

    <div class="newsletter-popup__content">
      <h2 id="newsletter-popup-title" class="newsletter-popup__title">
        Make AI Work Smarter for You
      </h2>
      <p id="newsletter-popup-desc" class="newsletter-popup__desc">
        Get practical AI tips, useful AI tool recommendations, automation ideas and straightforward guides to help you save time and work smarter. No hype—just useful insights you can put into action.
      </p>

      <form class="newsletter-form" aria-label="Newsletter sign-up form">
        <label>
          <span class="sr-only">Email address</span>
          <input
            type="email"
            name="email"
            id="newsletter-popup-email"
            placeholder="Enter your email address"
            required
          />
        </label>
        <button type="submit" id="newsletter-popup-button" class="button button--primary">
          Get Practical AI Tips
        </button>
      </form>

      <p class="newsletter-popup__privacy">Useful insights only. Unsubscribe whenever you want.</p>

      <p id="newsletter-popup-message" class="newsletter-message" role="status"></p>
    </div>
  </div>
</div>

<script is:inline>
(() => {
  const STORAGE_KEY = 'prismbyte-newsletter-dismissed';
  const SUBSCRIBED_KEY = 'prismbyte-newsletter-subscribed';
  const SESSION_KEY = 'prismbyte-newsletter-session-shown';
  const SEVEN_DAYS = 7 * 24 * 60 * 60 * 1000;
  const MIN_SHOW_DELAY = 10000;
  const SCROLL_THRESHOLD = 0.40;
  const AUTO_CLOSE_DELAY = 1300;

  const popup = document.getElementById('newsletter-popup');
  const closeBtn = document.getElementById('newsletter-popup-close');
  const form = document.querySelector('.newsletter-form');
  const input = document.getElementById('newsletter-popup-email');
  const button = document.getElementById('newsletter-popup-button');
  const message = document.getElementById('newsletter-popup-message');

  if (!popup || !closeBtn || !form || !input || !button || !message) return;

  let submitting = false;
  let shown = false;
  let previouslyFocusedElement = null;
  let focusTrapListener = null;
  let autoCloseTimer = null;
  let pageLoadTime = Date.now();

  function isDismissed() {
    try {
      const val = localStorage.getItem(STORAGE_KEY);
      if (!val) return false;
      const [ts] = val.split('|');
      return Date.now() - parseInt(ts, 10) < SEVEN_DAYS;
    } catch {
      return false;
    }
  }

  function isSubscribed() {
    try {
      return localStorage.getItem(SUBSCRIBED_KEY) === '1';
    } catch {
      return false;
    }
  }

  function isSessionShown() {
    try {
      return sessionStorage.getItem(SESSION_KEY) === '1';
    } catch {
      return false;
    }
  }

  function markSessionShown() {
    try {
      sessionStorage.setItem(SESSION_KEY, '1');
    } catch {
      // fail silently
    }
  }

  function setMessage(text, type) {
    message.textContent = text;
    message.className = 'newsletter-message ' + type;
    message.setAttribute('aria-live', 'polite');
  }

  function clearMessage() {
    message.textContent = '';
    message.className = 'newsletter-message';
    message.removeAttribute('aria-live');
  }

  function setLoading(loading) {
    submitting = loading;
    button.disabled = loading;
    input.disabled = loading;
    button.textContent = loading ? 'Subscribing...' : 'Get Practical AI Tips';
  }

  function cancelAutoClose() {
    if (autoCloseTimer) {
      clearTimeout(autoCloseTimer);
      autoCloseTimer = null;
    }
  }

  function scheduleAutoClose() {
    cancelAutoClose();
    autoCloseTimer = setTimeout(() => {
      closePopup();
      autoCloseTimer = null;
    }, AUTO_CLOSE_DELAY);
  }

  function getFocusableElements() {
    const focusableSelector = [
      'a[href]',
      'button:not([disabled])',
      'input:not([disabled])',
      'select:not([disabled])',
      'textarea:not([disabled])',
      '[tabindex]:not([disabled]):not([tabindex="-1"])'
    ].join(', ');

    const elements = popup.querySelectorAll(focusableSelector);
    return Array.from(elements).filter((el) => {
      const style = window.getComputedStyle(el);
      const rect = el.getBoundingClientRect();
      return (
        style.display !== 'none' &&
        style.visibility !== 'hidden' &&
        el.offsetParent !== null &&
        rect.width > 0 &&
        rect.height > 0
      );
    });
  }

  function trapFocus(event) {
    if (popup.hasAttribute('hidden')) return;
    if (event.key !== 'Tab') return;

    const focusable = getFocusableElements();
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    const active = document.activeElement;

    if (!popup.contains(active)) {
      event.preventDefault();
      first.focus({ preventScroll: true });
      return;
    }

    if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus({ preventScroll: true });
    }
    if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus({ preventScroll: true });
    }
  }

  function openPopup() {
    if (shown || isDismissed() || isSubscribed() || isSessionShown() || submitting) return;
    if (Date.now() - pageLoadTime < MIN_SHOW_DELAY) return;

    previouslyFocusedElement = document.activeElement;
    popup.removeAttribute('hidden');
    popup.setAttribute('aria-modal', 'true');
    input.focus({ preventScroll: true });
    shown = true;
    markSessionShown();

    focusTrapListener = (event) => trapFocus(event);
    document.addEventListener('keydown', focusTrapListener);

    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'newsletter_popup_view',
        page_location: window.location.href,
        page_title: document.title,
        page_path: window.location.pathname,
      });
    } catch {
      // fail silently
    }
  }

  function closePopup() {
    popup.setAttribute('hidden', '');
    popup.removeAttribute('aria-modal');
    shown = false;
    cancelAutoClose();

    if (focusTrapListener) {
      document.removeEventListener('keydown', focusTrapListener);
      focusTrapListener = null;
    }

    if (previouslyFocusedElement && document.body.contains(previouslyFocusedElement)) {
      previouslyFocusedElement.focus({ preventScroll: true });
    } else {
      document.body.focus({ preventScroll: true });
    }
    previouslyFocusedElement = null;
  }

  function shouldShowByScroll() {
    return window.scrollY > window.innerHeight * SCROLL_THRESHOLD;
  }

  function maybeShowFromScroll() {
    if (shouldShowByScroll()) {
      openPopup();
      window.removeEventListener('scroll', onScroll);
      clearTimeout(timer);
    }
  }

  function maybeShowFromTimer() {
    if (shouldShowByScroll()) {
      openPopup();
      window.removeEventListener('scroll', onScroll);
      clearTimeout(timer);
    }
  }

  let timer;
  let onScroll;

  try {
    const dismissed = localStorage.getItem(STORAGE_KEY);
    if (!dismissed && !isSubscribed()) {
      timer = setTimeout(maybeShowFromTimer, MIN_SHOW_DELAY);
      onScroll = () => maybeShowFromScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  } catch {
    // localStorage unavailable — fail silently, never show popup
  }

  closeBtn.addEventListener('click', () => {
    closePopup();
    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'newsletter_popup_dismiss',
        page_location: window.location.href,
        page_title: document.title,
        page_path: window.location.pathname,
      });
    } catch {
      // fail silently
    }
    try {
      localStorage.setItem(STORAGE_KEY, Date.now() + '|dismissed');
    } catch {
      // fail silently
    }
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (submitting) return;

    clearMessage();
    const email = input.value.trim();

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setMessage('Please enter a valid email address.', 'error');
      input.focus();
      return;
    }

    setLoading(true);

    try {
      const response = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });

      const data = await response.json().catch(() => ({}));

      if (response.ok) {
        setMessage(data.message || 'You are now subscribed.', 'success');
        try {
          localStorage.setItem(SUBSCRIBED_KEY, '1');
          localStorage.setItem(STORAGE_KEY, Date.now() + '|subscribed');
        } catch {
          // fail silently
        }
        scheduleAutoClose();
        try {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'newsletter_signup',
            page_location: window.location.href,
            page_title: document.title,
            page_path: window.location.pathname,
          });
        } catch {
          // fail silently
        }
      } else if (response.status === 409) {
        setMessage("You're already subscribed! Thanks for being part of Prismbyte.", 'success');
        try {
          localStorage.setItem(SUBSCRIBED_KEY, '1');
          localStorage.setItem(STORAGE_KEY, Date.now() + '|subscribed');
        } catch {
          // fail silently
        }
        scheduleAutoClose();
      } else {
        setMessage(data.error || 'Something went wrong. Please try again later.', 'error');
      }
    } catch {
      setMessage('Unable to connect. Please check your connection and try again.', 'error');
    } finally {
      setLoading(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !popup.hasAttribute('hidden')) {
      closePopup();
      try {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'newsletter_popup_dismiss',
          page_location: window.location.href,
          page_title: document.title,
          page_path: window.location.pathname,
        });
      } catch {
        // fail silently
      }
      try {
        localStorage.setItem(STORAGE_KEY, Date.now() + '|dismissed');
      } catch {
        // fail silently
      }
    }
  });
})();
</script>
