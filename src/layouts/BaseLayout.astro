---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsletterPopup from '../components/NewsletterPopup.astro';
import { site } from '../data/site';
import '../styles/global.css';

const {
  title,
  description = site.description,
  canonical,
  image,
  publishedDate,
  modifiedDate,
} = Astro.props as {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  publishedDate?: string | Date;
  modifiedDate?: string | Date;
};

const pageTitle = title ? `${title} | ${site.name}` : site.name;

// Theme initialization: run in <head> to prevent flash of incorrect theme.
// Reads saved preference, falls back to system preference, then light.
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).toString();
const socialImage = image ?? '/favicon.svg';

const organizationJson = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: `${site.url}/favicon.svg`,
  email: site.email,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="impact-site-verification" value="7c27c00f-59b6-4c92-9059-0be5017f6ef1" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <script
      is:inline
      id="theme-init"
    >(() => {
      const STORAGE_KEY = 'prismbyte-theme';
      const root = document.documentElement;
      let theme;
      try {
        theme = localStorage.getItem(STORAGE_KEY);
      } catch {
        // Fall back to the system preference.
      }
      if (!theme) {
        theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        try {
          localStorage.setItem(STORAGE_KEY, theme);
        } catch {
          // Apply the theme even if it cannot be saved.
        }
      }
      root.setAttribute('data-theme', theme);
    })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${site.url}${socialImage}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}${socialImage}`} />

    {publishedDate && (
      <meta property="article:published_time" content={new Date(publishedDate).toISOString()} />
    )}
    {modifiedDate && (
      <meta property="article:modified_time" content={new Date(modifiedDate).toISOString()} />
    )}

    <!-- Google Tag Manager -->
    <script async src="/gtm.js"></script>
    <!-- End Google Tag Manager -->

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1756622164439049" crossorigin="anonymous"></script>
    <!-- End Google AdSense -->

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />

    <title>{pageTitle}</title>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationJson)}
    />
  </head>

  <body>
    <a href="#main-content" class="sr-only focus-visible">Skip to main content</a>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PBTM9VBW"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <Header />

    <main class="page-shell" id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- Affiliate click tracking -->
    <script is:inline>
      document.addEventListener('click', function (event) {
        const target = event.target;
        const link = target instanceof Element
          ? target.closest('a[data-affiliate-link="true"]')
          : null;

        if (!link) return;

        window.dataLayer = window.dataLayer || [];

        window.dataLayer.push({
          event: 'affiliate_click',
          product_name: link.dataset.productName || '',
          link_url: link.href,
          link_text: link.textContent.trim(),
          page_location: window.location.href,
          page_title: document.title
        });
      });
    </script>

    <NewsletterPopup />
  </body>
</html>